# Copy to .env and fill in, then run ./setup.sh

# Your Matrix user IDs will look like @you:SERVER_NAME. It can't be changed later.
SERVER_NAME=matrix.simas.fit
# The public HTTPS address the app connects to (usually the same host).
MATRIX_HOST=matrix.simas.fit
# The username you'll sign in with.
ADMIN_USER=s

# Which apps to bridge (any of: whatsapp telegram facebook instagram imessage).
BRIDGES="whatsapp telegram facebook instagram imessage"

# Telegram needs your own API keys: https://my.telegram.org/apps → "API development tools".
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# iMessage: the BlueBubbles server app on your Mac (see README). Leave the password
# empty to skip iMessage. The URL default works when this server runs on that same Mac.
BLUEBUBBLES_URL=http://host.docker.internal:1234
BLUEBUBBLES_PASSWORD=

# Your iCloud contacts (names in the app, and saving contact cards you confirm).
# Apple ID email + an app-specific password from appleid.apple.com →
# Sign-In and Security → App-Specific Passwords. Leave empty to read contacts
# from BlueBubbles on the Mac instead (read-only).
ICLOUD_USER=
ICLOUD_APP_PASSWORD=

# Cloudflare Zero Trust → Networks → Tunnels → Create → copy the token.
# Leave empty if you use your own reverse proxy instead.
CLOUDFLARE_TUNNEL_TOKEN=

# Push notifications: the Apple/Google push services may use this address to
# reach whoever runs the server. Defaults to push@SERVER_NAME.
PUSH_CONTACT_EMAIL=

# Filled in by setup.sh
POSTGRES_PASSWORD=
COMPOSE_PROFILES=

# iPhone app notifications (through Apple). Put the APNs key from developer.apple.com →
# Keys at data/sygnal/apns.p8, fill these in and run ./setup.sh again.
APNS_KEY_ID=
APNS_TEAM_ID=

# Reply suggestions written by Claude on your Claude subscription (no API key): install
# Claude Code on the server, run `claude setup-token`, and put the token here.
SUGGEST_CLAUDE_TOKEN=
SUGGEST_CLAUDE_MODEL=sonnet
